{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jynx.dev/schemas/Judgment.schema.json",
  "title": "Judgment",
  "description": "Typed adjudication outcome under a rubric version. PASS means rubric satisfaction, not truth. Authoritative: jynx-rules (provisional).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judgment_id",
    "protocol_version",
    "judge",
    "outcome",
    "rubric",
    "evidence_refs",
    "issued_at"
  ],
  "properties": {
    "judgment_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "judge": { "$ref": "https://jynx.dev/schemas/common/LogicalRef.schema.json" },
    "move_id": { "type": "string" },
    "round_id": { "type": "string" },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INCONCLUSIVE", "CHALLENGED", "REPLICATED", "FALSIFIED"]
        },
        "detail": { "type": "string" },
        "scoring_vector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V", "I", "C"],
          "properties": {
            "V": { "type": "number", "description": "Validity component" },
            "I": { "type": "number", "description": "Information gain component" },
            "C": { "type": "number", "description": "Cost component" }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "version"],
      "properties": {
        "logical_id": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev:[a-f0-9]{64}$"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "adjudicator": { "$ref": "https://jynx.dev/schemas/common/ActorRef.schema.json" }
  }
}
