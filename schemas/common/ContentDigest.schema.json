{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jynx.dev/schemas/common/ContentDigest.schema.json",
  "title": "ContentDigest",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "hex"],
  "properties": {
    "algorithm": {
      "type": "string",
      "enum": ["sha256"]
    },
    "hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
