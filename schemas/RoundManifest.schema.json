{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jynx.dev/schemas/RoundManifest.schema.json",
  "title": "RoundManifest",
  "description": "Immutable pin of round R_k: exact releases, digests, constraints, and active objectives.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round_id",
    "protocol_version",
    "started_at",
    "immutable",
    "pinned_components",
    "compatibility_constraints",
    "evaluation_inputs",
    "environment",
    "active_objectives"
  ],
  "properties": {
    "round_id": { "type": "string", "minLength": 1 },
    "tournament_id": { "type": "string" },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "immutable": {
      "type": "boolean",
      "const": true
    },
    "pinned_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_role",
          "logical_id",
          "release_version",
          "commit_sha",
          "content_digest"
        ],
        "properties": {
          "component_role": {
            "type": "string",
            "enum": [
              "arena",
              "rules",
              "science",
              "lab",
              "engine",
              "judge",
              "world"
            ]
          },
          "logical_id": { "type": "string", "minLength": 1 },
          "release_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "content_digest": { "$ref": "https://jynx.dev/schemas/common/ContentDigest.schema.json" }
        }
      }
    },
    "compatibility_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "constraint_ref": { "$ref": "https://jynx.dev/schemas/common/LogicalRef.schema.json" }
        }
      }
    },
    "evaluation_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "content_digest"],
        "properties": {
          "input_id": { "type": "string" },
          "content_digest": { "$ref": "https://jynx.dev/schemas/common/ContentDigest.schema.json" },
          "held_out": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "lock_digest"],
      "properties": {
        "environment_id": { "type": "string" },
        "lock_digest": { "$ref": "https://jynx.dev/schemas/common/ContentDigest.schema.json" },
        "container_image_digest": { "$ref": "https://jynx.dev/schemas/common/ContentDigest.schema.json" }
      }
    },
    "active_objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "helper_dependency_dag": {
      "type": "object",
      "description": "Adjacency list: helper logical_id -> depends_on logical_ids (must be acyclic).",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
